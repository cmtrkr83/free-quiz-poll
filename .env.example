# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# Docker Compose .env dosyasını otomatik okur.
# Doğrudan Node ile: node --env-file-if-exists=.env server.js  (Node 20.19+)

# Dışarıdan erişilen adres. QR kodlar ve paylaşılan bağlantılar bu adresi kullanır.
# LAN örneği: http://192.168.1.42:3000
# Tünel örneği: https://oturum.ornek.com
# Boş bırakılırsa isteğin geldiği host kullanılır (localhost sorunlarına yol açabilir).
PUBLIC_URL=

# Doluysa yeni yönetici hesabı açmak için bu kayıt anahtarı gerekir.
# Genel/İnternete açık sunucularda mutlaka güçlü bir değer girin.
# Boşsa kayıt açıktır (IP başına saatte 5 kayıt denemesi sınırı vardır).
# Mevcut hesaplar bu anahtar değişse de giriş yapmaya devam eder.
ADMIN_KEY=

# Docker Compose için dış port. Doğrudan Node çalıştırmada da PORT olarak kullanılır.
PORT=3000

# Bu günden eski etkinlikler otomatik silinir.
EVENT_TTL_DAYS=14

# Saklanabilecek en fazla etkinlik sayısı.
MAX_EVENTS=500

# Ters proxy / tünel arkasında 1, doğrudan bağlantıda 0.
TRUST_PROXY=1
